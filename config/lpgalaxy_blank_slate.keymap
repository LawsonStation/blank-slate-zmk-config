#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define QWERTY_BASE 1

#define NAV_L 1
#define NUM_L 2
#define SYM_L 3
#define ADJ_L 4

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick_tap_ms = <200>; };

// Set Mod-Tap tapping term
&mt { 
    tapping-term-ms = <200>;
    // TODO: see if there is a global-quick-tap setting
    quick-tap-ms = <0>;
};

#define BT(n) BT_SEL n
#define BTx(n) BT_DISC n
#define BTc BT_CLR_ALL

/ {
    behaviors {
        // Adapted from https://zmk.dev/docs/keymaps/behaviors/hold-tap#option-2-tap-preferred
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };
    
    macros {
      /* ZMK_MACRO(thumbs_up,
		wait-ms = <1>;
		tap-ms = <5>;
                bindings = <&kp PLUS &kp COLON &kp PLUS &kp N1 &kp COLON &kp RET>;
		) */
    };
    
    tap_dances {
    	shifty: shift_caps_word {
		compatible = "zmk,behavior-tap-dance";
		label = "TD_SHIFTY";
		#binding-cells = <0>;
		tapping-term-ms = <150>;
		bindings = <&kp LSHFT>, <&caps_word>;
	};
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
#ifdef QWERTY_BASE
 &kp TAB        &kp Q      &kp W      &kp E       &kp R         &kp T          &kp Y            &kp U          &kp I       &kp O      &kp P         &kp MINUS
 &hm LCTRL ESC  &kp A 	   &hm LALT S &hm LGUI D  &hm LSHFT F   &kp G          &kp H            &hm LSHFT J    &hm LGUI K  &hm LALT L &kp SEMI &kp QUOT
 &kp LSHFT      &kp Z      &kp X      &hm LCTRL C &hm LCTRL V   &kp B          &kp N            &hm LCTRL M    &hm LCTRL COMMA  &kp DOT    &kp FSLH      &kp RET
#else
 &kp TAB        &kp Q      &kp W      &kp F       &kp P         &kp B          &kp J            &kp L          &kp U       &kp Y      &kp QUOT      &kp MINUS
 &hm LCTRL ESC  &hp A 	   &hm LALT R &hm LGUI S  &hm LSHFT T   &kp G          &kp M            &hm LSHFT N    &hm LGUI E  &hm LALT I &kp O   	    &kp QUOT
 &kp LSHFT      &kp Z      &kp X      &km LCTRL C &hm LCTRL D   &kp V          &kp K            &hm LCTRL H    &hm LCTRL COMMA	&kp DOT    &kp SEMI      &kp RET
#endif
 &kp LCTRL      &mo ADJ_L  &kp LGUI  &kp LALT    &mo NAV_L      &kp SPACE      &kp RET          &mo NUM_L      &kp BSPC    &kp DEL    &kp PG_DN     &kp PG_UP
            >;
        };

        nav_layer {
            label = "Nav";
            bindings = <
&trans          &kp F12     &kp F7     &kp F8      &kp F9           &trans       &trans    &trans           &trans      &trans          &trans &trans
&trans          &kp F11     &hm LALT F4 &hm LGUI F5 &hm LSHFT F6    &trans       &kp LEFT  &hm LSHFT DOWN   &hm LGUI UP &hm LALT RIGHT &trans &trans
&trans          &kp F10     &kp F1     &hm LCTRL F2 &hm LCTRL F3    &trans       &kp HOME  &hm LCTRL PG_UP  &hm LCTRL PG_DN &kp END         &trans &trans
&trans          &trans      &trans     &trans      &trans           &trans       &trans    &trans           &trans      &trans          &trans &trans
            >;
        };

        num_layer {
            label = "Num";
            bindings = <
&trans          &kp BSLH    &kp N7      &kp N8      &kp N9          &kp LBKT    &kp RBKT    &kp PLUS   &kp MINUS   &kp STAR     &kp SLASH   &trans
&trans          &kp EQUAL   &hm LALT N4 &hm LGUI N5  &hm LSHFT N6    &kp LPAR    &kp RPAR    &kp LSHFT  &kp LGUI    &kp LALT     &kp DLLR    &kp PRCNT
&trans          &kp MINUS   &kp N1      &hm LCTRL N2 &hm LCTRL N3    &kp GRAVE   &kp EQUAL   &kp LCTRL  &hm LCTRL COMMA  &kp DOT      &kp SLASH   &trans
&trans          &trans      &trans      &kp DOT     &kp N0          &trans      &trans      &kp ESC    &kp DEL     &trans       &trans      &trans
            >;
        };

        // TODO: fix or deprecate
        sym_layer {
            label = "Sym";
            bindings = <
&trans     &kp LBRC   &kp AMPS   &kp STAR    &kp LPAR     &kp RBRC     &trans     &trans    &trans       &trans       &trans     &bootloader
&trans     &kp COLON  &kp DLLR   &kp PRCNT   &kp CARET    &kp PLUS     &trans     &trans    &trans       &trans       &trans     &trans
&trans     &kp TILDE  &kp EXCL   &kp AT      &kp HASH     &kp PIPE     &trans     &trans    &trans       &trans       &trans     &trans
&trans     &trans        &trans     &kp RPAR        &trans          &trans       &trans    &trans  &trans         &trans &trans &trans

            >;
        };

        adj_layer {
            label = "Adj";
            bindings = <
&bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &trans      &trans      &trans      &trans  &trans  &trans      &bt BTc      &soft_off      &bootloader
&trans      &bt BTx(0)  &bt BTx(1)  &bt BTx(2)  &bt BTx(3)  &bt BTx(4)  &trans  &trans  &trans      &trans       &trans         &kp C_PLAY_PAUSE
&trans      &bt BT(0)   &bt BT(1)   &bt BT(2)   &bt BT(3)   &bt BT(4)   &trans  &trans  &trans      &trans       &trans         &kp C_MUTE
&trans      &trans      &trans      &trans      &trans      &trans      &trans  &trans  &kp C_PREV  &kp C_VOL_DN &kp C_VOL_UP   &kp C_NEXT

            >;
        };



    };
};

